{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow release evidence",
  "type": "object",
  "required": [
    "workflow",
    "reviewed_by",
    "reviewed_at",
    "source_refs",
    "evaluation_refs",
    "coverage"
  ],
  "properties": {
    "workflow": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evaluation_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "profile",
          "court_ids",
          "effective_from",
          "applicability"
        ],
        "properties": {
          "profile": {
            "type": "string"
          },
          "court_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effective_from": {
            "type": "string"
          },
          "effective_until": {
            "type": [
              "string",
              "null"
            ]
          },
          "applicability": {
            "const": "supported"
          }
        }
      }
    }
  }
}
